    },
    {
      "stepIndex": 3,
      "intent": "Enter password into the login form",
      "cliRefSource": "e5",
      "action": "fill",
      "inputDataRef": "UserBuilder.standardUser().password",
      "componentCandidate": "LoginFormComponent",
      "locatorContract": {
        "parentScope": {
          "strategy": "locator",

# Agentic-SOLID-QE Environment & Persona Credentials Template
# Copy this file to .env (which is git-ignored) and supply live values for your target environment.

# Target application Base URL consumed by playwright.config.ts
BASE_URL=https://www.saucedemo.com

# Reference SauceDemo persona password consumed by src/data/user.builder.ts
SAUCEDEMO_PASSWORD=secret_sauce

# Consumer application persona credentials (used after running `npm run init:app`)
TEST_USERNAME=test.user@example.com
TEST_PASSWORD=

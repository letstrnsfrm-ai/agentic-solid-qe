{
  "name": "agentic-solid-qe",
  "version": "0.2.0",
  "description": "Zero-API-key agent skill framework bridging Autonomous Exploratory Testing (@playwright/cli) and SOLID Playwright TypeScript Architecture.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agentic-solid-qe": "./scripts/sync-skills.mjs"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "coverage:gaps": "node scripts/analyze-coverage.mjs",
    "audit:solid": "node scripts/audit-solid.mjs",
    "validate:tapes": "node scripts/validate-tapes.mjs",
    "verify": "npm run typecheck && npm run audit:solid && npm run validate:tapes && npm test",
    "sync:skills": "node scripts/sync-skills.mjs",
    "upgrade:skills": "npx --yes github:letstrnsfrm-ai/agentic-solid-qe sync"
  },
  "keywords": [
    "playwright",
    "playwright-cli",
    "agent-skills",
    "solid-principles",
    "exploratory-testing",
    "quality-engineering",
    "sdet",
    "github-copilot",
    "antigravity",
    "claude-code",
    "cursor"
  ],
  "devDependencies": {
    "@playwright/cli": "^0.1.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}

{
  "name": "agentic-solid-qe",
  "version": "0.2.0",
  "description": "Zero-API-key agent skill framework bridging Autonomous Exploratory Testing (@playwright/cli) and SOLID Playwright TypeScript Architecture.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cortex": "./scripts/sync-skills.mjs",
    "asqe": "./scripts/sync-skills.mjs",
    "agentic-solid-qe": "./scripts/sync-skills.mjs"
  },
  "scripts": {
    "cortex": "node scripts/sync-skills.mjs",
    "asqe": "node scripts/sync-skills.mjs",
    "test": "playwright test --project=chromium --pass-with-no-tests",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "domain:graph": "node scripts/build-domain-graph.mjs",
    "migrate:skill": "node scripts/migrate-skill.mjs",
    "coverage:gaps": "node scripts/analyze-coverage.mjs",
    "audit:solid": "node scripts/audit-solid.mjs",
    "validate:tapes": "node scripts/validate-tapes.mjs",
    "verify": "npm run typecheck && npm run domain:graph && npm run audit:solid && npm run validate:tapes && npm test",
    "release:preview": "node scripts/generate-release-notes.mjs --dry-run",
    "init:app": "node scripts/sync-skills.mjs init --reset",
    "sync:skills": "node scripts/sync-skills.mjs",
    "upgrade:skills": "npx --yes github:letstrnsfrm-ai/agentic-solid-qe#v0.2.0 sync"
  },
  "keywords": [
    "playwright",
    "playwright-cli",
    "agent-skills",
    "solid-principles",
    "exploratory-testing",
    "quality-engineering",
    "sdet",
    "github-copilot",
    "antigravity",
    "claude-code",
    "cursor"
  ],
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "playwright": "1.64.1",
    "playwright-core": "1.64.1"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/letstrnsfrm-ai/agentic-solid-qe/schemas/session-tape.schema.json",
  "title": "Agentic-SOLID-QE Session Tape",
  "description": "Strict contract bridging Skill 01 (CLI Explorer) and Skill 02 (SOLID Architect). Translates ephemeral @playwright/cli YAML refs into hierarchical, strict-mode-safe Playwright semantic locators.",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "title",
    "charter",
    "recordedAt",
    "baseUrl",
    "persona",
    "preconditions",
    "semanticSteps",
    "networkContracts",
    "expectedStates"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Kebab-case unique identifier matching the tape filename."
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "charter": {
      "type": "string",
      "enum": [
        "happy-path-baseline",
        "boundary-analysis",
        "state-interruption",
        "chaos-network-500",
        "multi-persona-auth"
      ]
    },
    "tags": {
      "type": "array",
      "description": "Optional CI/CD execution tags (e.g., @p0, @smoke, @regression, @checkout).",
      "items": {
        "type": "string",
        "pattern": "^@[a-z0-9-]+$"
      }
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "persona": {
      "type": "object",
      "required": ["role", "dataBuilderRef"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "dataBuilderRef": {
          "type": "string",
          "description": "Reference to a typed Data Builder method in src/data/ (e.g. UserBuilder.standardUser)."
        },
        "storageStatePath": {
          "type": "string",
          "description": "Optional reusable Playwright storageState path (e.g., .auth/standard.json) generated by 00-env-bootstrap."
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "capturedVariables": {
      "type": "array",
      "description": "Optional cross-page runtime values captured during earlier steps (e.g. generated Order ID, Quote ID, dynamic total) to assert on subsequent pages.",
      "items": {
        "type": "object",
        "required": ["name", "capturedAtStep", "source"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$" },
          "capturedAtStep": { "type": "integer", "minimum": 1 },
          "source": {
            "type": "string",
            "enum": ["textContent", "inputValue", "urlParam", "attribute"]
          },
          "description": { "type": "string" }
        }
      }
    },
    "semanticSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepIndex",
          "intent",
          "action",
          "componentCandidate",
          "locatorContract"
        ],
        "additionalProperties": false,
        "properties": {
          "stepIndex": { "type": "integer", "minimum": 1 },
          "intent": { "type": "string" },
          "pageRoute": {
            "type": "string",
            "description": "Optional route path where this step executes in a multi-page flow (e.g. /checkout-step-one.html)."
          },
          "cliRefSource": {
            "type": "string",
            "description": "Original ephemeral ref from .playwright-cli/page-*.yml (e.g., e14) for audit traceability."
          },
          "action": {
            "type": "string",
            "enum": [
              "goto",
              "fill",
              "click",
              "selectOption",
              "press",
              "check",
              "uncheck",
              "hover",
              "upload",
              "waitFor",
              "route"
            ]
          },
          "inputDataRef": {
            "type": "string",
            "description": "Symbolic reference to src/data/ builder field (never raw magic strings in specs)."
          },
          "waitForUrl": {
            "type": "string",
            "description": "Optional URL path or glob to synchronize multi-page navigation after this step."
          },
          "waitForNetwork": {
            "type": "string",
            "description": "Optional API URL pattern from networkContracts to await after triggering this action."
          },
          "capturesVariable": {
            "type": "string",
            "description": "Optional variable name (matching capturedVariables) extracted from this element for cross-page verification."
          },
          "componentCandidate": {
            "type": "string",
            "description": "Suggested SRP Component or Page class name (e.g., LoginFormComponent, InventoryListComponent)."
          },
          "locatorContract": {
            "type": "object",
            "description": "Hierarchical Locator Contract ensuring strict-mode safety on complex pages.",
            "required": ["strategy", "value"],
            "additionalProperties": false,
            "properties": {
              "iframeSelector": {
                "type": "string",
                "description": "Optional iframe selector when the target control lives inside an embedded frame."
              },
              "parentScope": {
                "type": "object",
                "description": "Optional parent landmark/container scoping (e.g., dialog, form, region, listitem, table row) to prevent strict-mode collisions.",
                "required": ["strategy", "value"],
                "additionalProperties": false,
                "properties": {
                  "strategy": {
                    "type": "string",
                    "enum": ["getByRole", "getByLabel", "getByTestId", "locator"]
                  },
                  "role": { "type": "string" },
                  "value": { "type": "string" },
                  "nameExact": { "type": "boolean" },
                  "filterTextRef": {
                    "type": "string",
                    "description": "Optional Data Builder reference or text filter (.filter({ hasText })) to disambiguate repeating rows/cards."
                  }
                }
              },
              "strategy": {
                "type": "string",
                "enum": ["getByRole", "getByLabel", "getByPlaceholder", "getByText", "getByTestId", "url"]
              },
              "role": {
                "type": "string",
                "description": "ARIA role when strategy is getByRole (e.g., button, textbox, heading, link)."
              },
              "value": {
                "type": "string",
                "description": "Accessible name, label, placeholder, text, or testId value."
              },
              "nameExact": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    },
    "networkContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["urlPattern", "method", "expectedStatus"],
        "additionalProperties": false,
        "properties": {
          "urlPattern": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "expectedStatus": { "type": "integer" },
          "maxLatencyMs": {
            "type": "integer",
            "description": "Optional SLA latency threshold observed during exploration."
          },
          "chaosFaultInjected": { "type": "boolean" }
        }
      }
    },
    "expectedStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "assertionType", "targetComponent", "targetProperty", "expectedValueRef"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "assertionType": {
            "type": "string",
            "enum": ["toBeVisible", "toBeHidden", "toHaveText", "toContainText", "toHaveCount", "toHaveURL", "toHaveValue"]
          },
          "targetComponent": {
            "type": "string",
            "description": "Fixture/Component exposing the readonly Locator."
          },
          "targetProperty": {
            "type": "string",
            "description": "Readonly Locator property or query method on the Component/Page."
          },
          "expectedValueRef": {
            "type": "string",
            "description": "Symbolic reference to src/data/ builder, expected constant, or capturedVariable:<name>."
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/letstrnsfrm-ai/agentic-solid-qe/schemas/session-tape.schema.json",
  "title": "Agentic-SOLID-QE Session Tape",
  "description": "Strict contract bridging Skill 01 (CLI Explorer) and Skill 02 (SOLID Architect). Translates ephemeral @playwright/cli YAML refs into hierarchical, strict-mode-safe Playwright semantic locators.",
  "type": "object",
  "required": [
    "schemaVersion",
    "scenarioId",
    "title",
    "charter",
    "recordedAt",
    "baseUrl",
    "persona",
    "preconditions",
    "semanticSteps",
    "networkContracts",
    "expectedStates"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Kebab-case unique identifier matching the tape filename."
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "charter": {
      "type": "string",
      "enum": [
        "happy-path-baseline",
        "boundary-analysis",
        "state-interruption",
        "chaos-network-500",
        "multi-persona-auth"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseUrl": {
      "type": "string",
      "format": "uri"
    },
    "persona": {
      "type": "object",
      "required": ["role", "dataBuilderRef"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string" },
        "dataBuilderRef": {
          "type": "string",
          "description": "Reference to a typed Data Builder method in src/data/ (e.g. UserBuilder.standardUser)."
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "semanticSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "stepIndex",
          "intent",
          "action",
          "componentCandidate",
          "locatorContract"
        ],
        "additionalProperties": false,
        "properties": {
          "stepIndex": { "type": "integer", "minimum": 1 },
          "intent": { "type": "string" },
          "cliRefSource": {
            "type": "string",
            "description": "Original ephemeral ref from .playwright-cli/page-*.yml (e.g., e14) for audit traceability."
          },
          "action": {
            "type": "string",
            "enum": ["goto", "fill", "click", "selectOption", "press", "check", "uncheck", "route"]
          },
          "inputDataRef": {
            "type": "string",
            "description": "Symbolic reference to src/data/ builder field (never raw magic strings in specs)."
          },
          "componentCandidate": {
            "type": "string",
            "description": "Suggested SRP Component or Page class name (e.g., LoginFormComponent, InventoryListComponent)."
          },
          "locatorContract": {
            "type": "object",
            "description": "Hierarchical Locator Contract ensuring strict-mode safety on complex pages.",
            "required": ["strategy", "value"],
            "additionalProperties": false,
            "properties": {
              "parentScope": {
                "type": "object",
                "description": "Optional parent landmark/container scoping (e.g., dialog, form, region, listitem) to prevent strict-mode collisions.",
                "required": ["strategy", "value"],
                "additionalProperties": false,
                "properties": {
                  "strategy": {
                    "type": "string",
                    "enum": ["getByRole", "getByLabel", "getByTestId", "locator"]
                  },
                  "role": { "type": "string" },
                  "value": { "type": "string" },
                  "nameExact": { "type": "boolean" }
                }
              },
              "strategy": {
                "type": "string",
                "enum": ["getByRole", "getByLabel", "getByPlaceholder", "getByText", "getByTestId", "url"]
              },
              "role": {
                "type": "string",
                "description": "ARIA role when strategy is getByRole (e.g., button, textbox, heading, link)."
              },
              "value": {
                "type": "string",
                "description": "Accessible name, label, placeholder, text, or testId value."
              },
              "nameExact": {
                "type": "boolean",
                "default": true
              }
            }
          }
        }
      }
    },
    "networkContracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["urlPattern", "method", "expectedStatus"],
        "additionalProperties": false,
        "properties": {
          "urlPattern": { "type": "string" },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "expectedStatus": { "type": "integer" },
          "chaosFaultInjected": { "type": "boolean" }
        }
      }
    },
    "expectedStates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["description", "assertionType", "targetComponent", "targetProperty", "expectedValueRef"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "assertionType": {
            "type": "string",
            "enum": ["toBeVisible", "toBeHidden", "toHaveText", "toContainText", "toHaveCount", "toHaveURL"]
          },
          "targetComponent": {
            "type": "string",
            "description": "Fixture/Component exposing the readonly Locator."
          },
          "targetProperty": {
            "type": "string",
            "description": "Readonly Locator property or query method on the Component/Page."
          },
          "expectedValueRef": {
            "type": "string",
            "description": "Symbolic reference to src/data/ builder or expected constant."
          }
        }
      }
    }
  }
}

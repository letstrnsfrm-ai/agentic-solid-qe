# Reference Zero-LLM-API-Key VPC Runner Image for Cortex QE Software Factory
# Outbound pull-only worker: zero bundled LLM SDKs, zero static LLM API keys.
FROM node:22-slim

ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci && npx playwright install --with-deps chromium

COPY . .

# Run as non-root user for VPC container hardening
RUN useradd -m -u 1001 cortex && chown -R cortex:cortex /workspace /ms-playwright
USER cortex

ENTRYPOINT ["node", "scripts/runner-daemon.mjs", "start"]
